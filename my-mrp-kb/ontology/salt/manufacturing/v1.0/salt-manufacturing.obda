[PrefixDeclaration]
:	https://example.org/ontology/salt/manufacturing/v1.0#

[MappingDeclaration] @collection [[
mappingId	class-knowledgebase
target		<https://example.org/ontology/salt/manufacturing/v1.0/synthetic/KnowledgeBase> a :KnowledgeBase .
source		SELECT 1 AS synthetic_row

mappingId	class-manufacturingresource
target		<https://example.org/ontology/salt/manufacturing/v1.0/synthetic/ManufacturingResource> a :ManufacturingResource .
source		SELECT 1 AS synthetic_row

mappingId	class-materialrequirement
target		<https://example.org/ontology/salt/manufacturing/v1.0/synthetic/MaterialRequirement> a :MaterialRequirement .
source		SELECT 1 AS synthetic_row

mappingId	class-workorder
target		<https://example.org/ontology/salt/manufacturing/v1.0/synthetic/WorkOrder> a :WorkOrder .
source		SELECT 1 AS synthetic_row

mappingId	object-requiresmaterial-workorder-materialrequirement
target		<https://example.org/ontology/salt/manufacturing/v1.0/synthetic/WorkOrder> :requiresMaterial <https://example.org/ontology/salt/manufacturing/v1.0/synthetic/MaterialRequirement> .
source		SELECT 1 AS synthetic_join_row

]]
